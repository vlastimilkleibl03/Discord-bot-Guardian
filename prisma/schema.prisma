// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ticket {
  id				Int      @id @default(autoincrement())
  userId			String
  guildId			String
  adminMessageId    String
  userMessageId		String
  category			String
}

model TicketCategory {
  guildId			String
  categoryName		String
  categoryChannel	String
  @@unique([guildId, categoryName])
}

model InfoChannel {
  guildId			String
  channelId			String
  type				String
  @@unique([guildId, type])
}

model ActiveBan {
  guildId			String
  userId			String
  unbanDate			DateTime
  @@unique([guildId, userId])
}

model BanRecord {
  id				Int      @id @default(autoincrement())
  guildId			String
  userId			String
  banDate			DateTime
  unbanDate			DateTime
  reason			String
}

model KickRecord {
  id				Int      @id @default(autoincrement())
  guildId			String
  userId			String
  kickDate			DateTime
  reason			String
}

model MuteRecord {
  id				Int      @id @default(autoincrement())
  guildId			String
  userId			String
  muteDate			DateTime
  length			Int
  reason			String
}
